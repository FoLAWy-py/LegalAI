# LegalAI runtime configuration. Copy to .env and fill in. Never commit .env.
# Only the interface department (composition root) reads these; it injects them into other departments.

# --- Model provider: DeepInfra, OpenAI-compatible API (ADR-0003) ---
DEEPINFRA_API_KEY=
LLM_BASE_URL=https://api.deepinfra.com/v1/openai
LLM_MODEL=deepseek-ai/DeepSeek-V4.1-Flash-1017
LLM_TEMPERATURE=0
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=2

# Model used by verification's model-based checks. Empty = same as LLM_MODEL (see ADR-0003, P2).
VERIFICATION_LLM_MODEL=

# --- Local storage (each department writes only to <LEGALAI_DATA_DIR>/<department>/) ---
LEGALAI_DATA_DIR=./data
